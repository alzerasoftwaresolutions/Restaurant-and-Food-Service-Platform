# Restaurant & Food Service Platform (RFSP) — Environment Variables
NODE_ENV=development
HOST=localhost
PORT=3000

# Security
JWT_SECRET=rfsp_core_v1_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=24h

# PostgreSQL Connection Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rfsp_core_v1
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=rfsp_core_v1
PGSSL=false
PGPOOL_MAX=20

# Public Publishing URL
PUBLIC_MENU_BASE_URL=http://localhost:3000/menu

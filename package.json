{
  "name": "rfsp-core-platform-v1",
  "version": "1.0.0",
  "description": "Restaurant & Food Service Platform (RFSP) — Core Platform v1",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env src/data/run-migrations.js",
    "seed": "node --env-file-if-exists=.env src/data/seed.js",
    "db:verify": "node --env-file-if-exists=.env src/data/verify-db.js",
    "health:check": "node --env-file-if-exists=.env tests/verify_endpoints.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "keywords": [
    "rfsp",
    "digital-menu",
    "restaurant",
    "modular-monolith",
    "postgresql"
  ],
  "author": "RFSP Architecture & Engineering Team",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0",
    "pg-mem": "^3.0.14",
    "qrcode": "^1.5.4"
  }
}

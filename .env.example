# ==============================================================================
# Restaurant & Food Service Platform (RFSP) — Core Platform v1
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local/staging execution.
# NEVER commit .env or real credentials/secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
# Runtime environment: 'development' | 'staging' | 'production'
NODE_ENV=development

# HTTP server host binding ('0.0.0.0' for containers/VMs, 'localhost' for local dev)
HOST=0.0.0.0

# HTTP server port
PORT=3000

# Logging verbosity: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info

# Allowed CORS Origins (comma-separated for multiple, or '*' for wide access)
# Staging/Production example: https://staging.aurabistro.com,https://admin.staging.aurabistro.com
CORS_ORIGIN=*

# Graceful shutdown timeout in milliseconds before forcing process termination
SHUTDOWN_TIMEOUT_MS=10000

# Controlled automatic demo seeding on startup if database is empty: 'true' | 'false'
# Set to false in staging and production to prevent unintended sample data generation.
AUTO_SEED=true

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Full Connection String URI (takes precedence if provided)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=[mode]
# Example: postgresql://rfsp_user:SecurePassword123!@staging-db.internal:5432/rfsp_staging
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rfsp_core_v1

# Option B: Individual PostgreSQL Parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=rfsp_core_v1

# Enable SSL for managed PostgreSQL (e.g. AWS RDS, DigitalOcean, Supabase, Neon)
# Set to 'true' in staging/production where TLS is required
PGSSL=false

# PostgreSQL Connection Pool Sizing
# Maximum active connections per Node.js process instance
PGPOOL_MAX=20

# Idle connection timeout in milliseconds
PGIDLE_TIMEOUT_MS=30000

# Connection acquisition timeout in milliseconds
PGCONN_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# JSON Web Token Secret Key.
# CRITICAL: In staging and production, this MUST be a cryptographically random
# string of at least 32 characters (e.g. generated via: openssl rand -base64 32).
# The application startup validator will reject default development secrets in staging/prod.
JWT_SECRET=rfsp_core_v1_super_secure_jwt_secret_key_2026

# JWT token expiration window (e.g. '24h', '7d', '12h')
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 4. DIGITAL MENU PUBLISHING & DOMAINS
# ------------------------------------------------------------------------------
# Canonical base URL for customer public menu destinations embedded into QR codes.
# Development: http://localhost:3000/menu
# Staging:     https://staging.aurabistro.com/menu
# Production:  https://aurabistro.com/menu
PUBLIC_MENU_BASE_URL=http://localhost:3000/menu

# ------------------------------------------------------------------------------
# 5. MEDIA ASSET STORAGE
# ------------------------------------------------------------------------------
# Local filesystem storage path for uploaded restaurant logos, banners, and food images.
# In containerized environments, mount a persistent volume to this directory.
# UPLOAD_DIR=/app/public/uploads
